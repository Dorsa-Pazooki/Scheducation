@page
@model Presentation.Pages.EnrollmentRequestsModel

@{
    ViewData["Title"] = "Enrollment Requests";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Enrollment Requests</h1>

        <a href="/Admin" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>Student</th>
            <th>Subject</th>
            <th>Teacher</th>
            <th>Room</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var enrollment in Model.EnrollmentRequests)
        {
            <tr>
                <td>@enrollment.StudentName</td>
                <td>@enrollment.Subject</td>
                <td>@enrollment.TeacherName</td>
                <td>@enrollment.RoomNumber</td>
                <td>@enrollment.StartDateTime</td>
                <td>@enrollment.EndDateTime</td>
                <td>@enrollment.Status</td>
                <td>
                    <form method="post" asp-page-handler="Approve" class="d-inline">
                        <input type="hidden" name="enrollmentId" value="@enrollment.EnrollmentId" />
                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                    </form>

                    <form method="post" asp-page-handler="Reject" class="d-inline">
                        <input type="hidden" name="enrollmentId" value="@enrollment.EnrollmentId" />
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>