@page
@model Presentation.Pages.StudentScheduleModel

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">My Schedule</h1>

        <a href="/Student" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <form method="get" class="mb-3">
        <select name="Status" class="form-control">
            <option value="">All</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </select>

        <button class="btn btn-primary mt-2">Filter</button>
    </form>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>Subject</th>
            <th>Teacher</th>
            <th>Room</th>
            <th>Start</th>
            <th>End</th>
            <th>Enrollment Status</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var enrollment in Model.Enrollments)
        {
            <tr>
                <td>@enrollment.Subject</td>
                <td>@enrollment.TeacherName</td>
                <td>@enrollment.RoomNumber</td>
                <td>@enrollment.StartDateTime</td>
                <td>@enrollment.EndDateTime</td>
                <td>@enrollment.Status</td>
            </tr>
        }
        </tbody>
    </table>
</div>