@page
@model Presentation.Pages.RegisterModel

<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="card shadow-lg rounded-4 border-0" style="width: 460px;">
        <div class="card-body p-5">
            <h2 class="text-center mb-2">Create Account</h2>
            <p class="text-muted text-center mb-4">Register as a student</p>

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="alert alert-info">@Model.Message</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">
                    Register
                </button>
            </form>

            <div class="text-center">
                <a href="/">Back to Login</a>
            </div>
        </div>
    </div>
</div>