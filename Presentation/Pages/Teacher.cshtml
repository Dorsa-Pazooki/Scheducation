@page
@model Presentation.Pages.TeacherModel
@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Teacher Dashboard</h1>
            <p class="text-muted mb-0">Choose a classroom and reserve it</p>
        </div>
        <a href="/Index" class="btn btn-outline-secondary">Back</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    <div class="row g-4">
        @foreach (var classroom in Model.Classrooms)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <h4 class="card-title">Room @classroom.RoomNumber</h4>
                        <p class="mb-1"><strong>Location:</strong> @classroom.Location</p>
                        <p class="mb-3"><strong>Capacity:</strong> @classroom.Capacity</p>

                        <form method="post" class="d-grid gap-2">
                            <input type="hidden" name="ClassroomId" value="@classroom.ClassroomId" />

                            <div>
                                <label class="form-label">Subject</label>
                                <input name="Subject" class="form-control" />
                            </div>

                            <div>
                                <label class="form-label">Reservation Time</label>
                                <input name="ReservationTime" type="datetime-local" class="form-control" />
                            </div>

                            <button type="submit" class="btn btn-primary mt-2">
                                Reserve
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>