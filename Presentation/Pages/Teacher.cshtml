@page
@model Presentation.Pages.TeacherModel
@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        
        <div>
            <h1 class="mb-1">Teacher Dashboard</h1>
            <a href="/TeacherSchedule" class="btn btn-outline-primary">My Schedule</a>
        </div>
        <a href="/Index" class="btn btn-outline-secondary">Back</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    <div class="row g-4">
        @foreach (var classroom in Model.Classrooms)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <h4 class="card-title">Room @classroom.RoomNumber</h4>
                        <p class="mb-1"><strong>Floor:</strong> @classroom.Location</p>
                        <p class="mb-3"><strong>Capacity:</strong> @classroom.Capacity</p>

                        <form method="post" class="d-grid gap-2">
                            <input type="hidden" name="ClassroomId" value="@classroom.ClassroomId" />

                            <div>
                                <label class="form-label">Subject</label>
                                <input name="Subject" class="form-control" />
                            </div>

                            <div>

                                <input name="ReservationDate" type="date" class="form-control" />

                                <select name="SelectedTimeSlot" class="form-control">
                                    <option value="">Choose time slot</option>
                                    <option value="09:00-10:30">09:00 - 10:30</option>
                                    <option value="10:45-12:15">10:45 - 12:15</option>
                                    <option value="12:30-14:00">12:30 - 14:00</option>
                                    <option value="14:15-15:45">14:15 - 15:45</option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary mt-2">
                                Reserve
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>