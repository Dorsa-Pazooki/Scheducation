@page
@model Presentation.Pages.AdminModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        
        <div>
            <h1 class="mb-1">Admin Dashboard</h1>
            <a href="/AdminSchedule" class="btn btn-outline-primary">All Schedules</a>
        </div>
        <a href="/Index" class="btn btn-outline-secondary">Back</a>
    </div>

    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h3 class="mb-3">Reservations</h3>

            @if (Model.Reservations.Count == 0)
            {
                <div class="alert alert-info mb-0">No reservations yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Reservation Id</th>
                                <th>Teacher</th>
                                <th>Room</th>
                                <th>Subject</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Date Requested</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var reservation in Model.Reservations)
                        {
                            <tr>
                                <td>@reservation.ReservationId</td>
                                <td>@reservation.TeacherName</td>
                                <td>@reservation.RoomNumber</td>
                                <td>@reservation.Subject</td>
                                <td>@reservation.StartDateTime</td>
                                <td>@reservation.EndDateTime</td>
                                <td>@reservation.DateRequested</td>
                                <td>
                                    <span class="badge bg-warning text-dark">@reservation.Status</span>
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="Approve" class="d-inline">
                                        <input type="hidden"
                                               name="reservationId"
                                               value="@reservation.ReservationId" />
                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Approve
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Reject" class="d-inline">
                                        <input type="hidden"
                                               name="reservationId"
                                               value="@reservation.ReservationId" />
                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Reject
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>