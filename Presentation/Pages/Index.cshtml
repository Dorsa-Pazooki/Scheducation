@page
@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow rounded-4">
                <div class="card-body p-5 text-center">
                    <h1 class="mb-3">Scheducation</h1>
                    <p class="text-muted mb-4">Choose a role to continue</p>

                    <div class="d-grid gap-3">
                        <a href="/Teacher" class="btn btn-primary btn-lg">Login as Teacher</a>
                        <a href="/Student" class="btn btn-success btn-lg">Login as Student</a>
                        <a href="/Admin" class="btn btn-dark btn-lg">Login as Admin</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>